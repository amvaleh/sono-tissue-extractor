# ---------------------------------------------------------------------------
# Patient data must never enter this repository.
# These rules are deliberately broad.
# ---------------------------------------------------------------------------
*.png
*.jpg
*.jpeg
*.bmp
*.tif
*.tiff
*.dcm
*.nii
*.nii.gz

# The ONLY images allowed in this repository: the SYNTHETIC illustrations used by the
# annotation guide (generated from random noise by docs/figures/make_guide_figures.py).
# Anything else with an image extension stays ignored, in docs/ as everywhere.
!docs/figures/guide_*.png

# Annotation work: frames copied from patient data, hand-drawn masks, and logs that name
# patient folders. Never commit any of it.
annotation_work/
selection.csv
annotations_log.csv
agreement_*.csv
evaluation*.csv

# Pipeline outputs (contain cropped patient imagery)
crops/
masks/
overlays/
extracted/
extracted_*/
work/
unet_run/

# Metadata that embeds patient folder names, IDs or acquisition timestamps
manifest.csv
mask_qc.csv
roi_boxes.csv
to_check.csv

# Model checkpoints — models/ is force-added explicitly, see README
*.pt
*.pth
!models/unet_tissue_v1.pt

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
